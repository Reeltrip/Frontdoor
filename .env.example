# 이 파일을 .env로 복사해서 값을 채워요. .env는 git에 올라가지 않아요.
# VITE_로 시작하는 값은 브라우저에 그대로 노출돼요. 비밀 키는 넣지 않아요.

# API 서버 주소 (끝에 / 없이)
VITE_API_BASE_URL=http://localhost:8080

# false면 실제 서버로 요청해요. 비워 두거나 true면 가짜 응답을 써요
VITE_USE_FAKE_API=true

# Google Maps JavaScript API 키. 브라우저에 노출되니 Google Cloud에서 HTTP 리퍼러 제한(localhost, Vercel 도메인)을 걸어요.
# 비워 두면 지도 자리에 '지도 키가 설정되지 않았어요' 화면이 나와요
VITE_GOOGLE_MAPS_API_KEY=

# 지도 ID. 사진 핀 마커에 필요해요. 비워 두면 구글의 테스트용 DEMO_MAP_ID를 써요
VITE_GOOGLE_MAPS_MAP_ID=
